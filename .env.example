# AI Provider Configuration
# Options: 'mock' (local testing without AWS) or 'bedrock' (real Amazon Bedrock inference)
AI_PROVIDER=bedrock

# Repository & Persistence Configuration
# Options: 'memory' (in-memory with demo seed data for local/tests) or 'dynamodb' (real Amazon DynamoDB)
REPOSITORY_PROVIDER=memory
DYNAMODB_TABLE=continuity-cases-dev

# Evidence Storage Configuration (Phase 4)
# Options: 'memory' (in-memory for local/tests) or 's3' (real Amazon S3 private bucket)
EVIDENCE_PROVIDER=memory
S3_BUCKET=continuity-evidence-dev
S3_PREFIX=cases

# AWS Configuration
# Credentials are read automatically via boto3's standard AWS credential provider chain
# (e.g. AWS CLI 'aws configure', ~/.aws/credentials, IAM roles, SSO, or environment variables).
# DO NOT put AWS_ACCESS_KEY_ID or AWS_SECRET_ACCESS_KEY into this file.
AWS_REGION=ap-south-1

# Amazon Bedrock Settings
BEDROCK_MODEL_ID=global.amazon.nova-2-lite-v1:0

# Application Settings
ENVIRONMENT=development
LOG_LEVEL=info

# Frontend Settings
NEXT_PUBLIC_API_URL=http://localhost:8000
